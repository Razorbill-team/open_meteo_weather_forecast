# Settings of the weather collector. Copy this file to .env (same folder) and fill in. Never commit .env.

# Database to write to: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
WEATHER_DB_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Table for weather forecasts (training and prediction), as schema.table (lowercase letters, digits and _ only)
WEATHER_FORECAST_TABLE=integration_schema.open_meteo_forecast_hourly
